7:["$","$L12",null,{"prefetchedGuides":[{"id":"6f48263c-1b3d-4de6-9dcb-2aeea7a6f3ed","title":"La poitrine de bœuf au fumoir","slug":"guide-poitrine-boeuf-brisket","summary":"La pièce reine du barbecue. Comment la trouver chez ton boucher, la parer, la fumer et la trancher.","cover_url":"https://images.pexels.com/photos/8753690/pexels-photo-8753690.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"viande","tags":["poitrine-de-boeuf","brisket","fumage","bbq","texas","flat","point","boucher"],"meat_type":"brisket","created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"a01232d5-c48c-4a93-9f57-9d0dfdb19ddd","title":"L'échine de porc au fumoir (pulled pork)","slug":"guide-echine-porc-pulled-pork","summary":"Le guide complet pour un effiloché de porc fondant : quelle pièce chez le boucher, assaisonnement, gestion du stall et effilochage.","cover_url":"https://images.pexels.com/photos/1212277/pexels-photo-1212277.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"viande","tags":["pulled-pork","echine","palette","epaule","low-and-slow","stall","effilochage"],"meat_type":"pulled_pork","created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"0502d354-853e-4dd5-bf10-abebe7dfe5dc","title":"Le plat de côtes de bœuf au fumoir","slug":"guide-plat-de-cotes-boeuf","summary":"Le plat de côtes (beef ribs) est une pièce spectaculaire au fumoir, qui rivalise avec la poitrine en saveur.","cover_url":"https://images.pexels.com/photos/8250702/pexels-photo-8250702.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"viande","tags":["plat-de-cotes","beef-ribs","boeuf","low-and-slow","fumage"],"meat_type":"beef_short_ribs","created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"027b8a5d-0734-4bf4-82c0-e6f09f98f6f5","title":"Le paleron au fumoir : l'alternative au brisket","slug":"guide-paleron-fumoir","summary":"Le paleron est une alternative économique à la poitrine avec un résultat tout aussi impressionnant. Disponible chez tous les bouchers.","cover_url":"https://images.pexels.com/photos/4765772/pexels-photo-4765772.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"viande","tags":["paleron","chuck-roast","pulled-beef","boeuf","debutant","low-and-slow"],"meat_type":"chuck_roast","created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"fbfe8389-1425-4c15-95bd-0649dce4b8ab","title":"Côte de bœuf et tomahawk au fumoir","slug":"guide-cote-de-boeuf-tomahawk","summary":"La saisie inversée : fumage doux puis saisie violente. La méthode idéale pour une côte de bœuf ou un tomahawk parfait.","cover_url":"https://images.pexels.com/photos/769289/pexels-photo-769289.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"viande","tags":["cote-de-boeuf","tomahawk","saisie-inversee","entrecote","boeuf","reverse-sear"],"meat_type":"prime_rib","created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"a3ccae7a-016b-472a-8365-e85e77e068c4","title":"Les travers de porc au fumoir : spare ribs et baby back","slug":"guide-travers-de-porc-ribs","summary":"Spare ribs ou baby back ? Méthode 3-2-1 ou sans wrap ? Tout ce qu'il faut savoir pour des travers parfaits.","cover_url":"https://images.pexels.com/photos/410648/pexels-photo-410648.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"viande","tags":["travers","spare-ribs","baby-back","ribs","3-2-1","2-2-1","porc"],"meat_type":"spare_ribs","created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"c9b2ecaf-d30c-4c2f-b1a7-6d170ee75e28","title":"Le poulet entier au fumoir","slug":"guide-poulet-entier-fumoir","summary":"Fumer un poulet entier demande une approche différente du low & slow classique. Plus chaud, plus rapide, et une peau qui craque.","cover_url":"https://images.pexels.com/photos/13458086/pexels-photo-13458086.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"viande","tags":["poulet","papillon","volaille","peau-croustillante","fumoir"],"meat_type":"whole_chicken","created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"3dcedb09-9301-4280-8005-3fadec958aa6","title":"L'agneau au fumoir : épaule, souris, gigot","slug":"guide-agneau-fumoir","summary":"L'agneau est le grand oublié du BBQ. L'épaule fumée donne un effiloché spectaculaire.","cover_url":"https://images.pexels.com/photos/3535383/pexels-photo-3535383.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"viande","tags":["agneau","epaule","souris","gigot","collier","pulled-lamb","fumoir"],"meat_type":"lamb_shoulder","created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"50ccbf9f-9988-4aca-8475-13694626efda","title":"Les burnt ends : les bonbons du pitmaster","slug":"guide-burnt-ends","summary":"Des cubes de viande caramélisés au fumoir. Le snack BBQ le plus addictif qui existe.","cover_url":"https://images.pexels.com/photos/8753690/pexels-photo-8753690.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"technique","tags":["burnt-ends","poitrine","boeuf","porc","caramelise","snack"],"meat_type":"brisket","created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"d292a0ee-f42b-44e4-868d-58bb867c0a6d","title":"Feu, charbon et bois de fumage","slug":"guide-feu-charbon-bois","summary":"Gérer son feu, choisir son charbon et son bois de fumage. Le guide complet pour maîtriser le combustible.","cover_url":"https://images.pexels.com/photos/69056/pexels-photo-69056.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"technique","tags":["feu","charbon","bois","fumage","ventilation","minion","chene","cerisier","hetre"],"meat_type":null,"created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"8b6cb5ed-3437-4b95-8a07-40a1e05a8211","title":"Le stall et l'emballage au fumoir","slug":"guide-stall-emballage","summary":"Le plateau thermique et les techniques d'emballage : comprendre le stall et savoir quand wrapper.","cover_url":"https://images.pexels.com/photos/1927383/pexels-photo-1927383.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"technique","tags":["stall","emballage","texas-crutch","papier-boucher","aluminium","wrap"],"meat_type":null,"created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"293410f2-8590-4674-9d87-b128ac946855","title":"La bark : comment obtenir une croûte parfaite","slug":"guide-bark-croute","summary":"La bark est la croûte sombre et savoureuse qui se forme au fumoir. Voici comment l'obtenir parfaite.","cover_url":"https://images.pexels.com/photos/5836779/pexels-photo-5836779.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"technique","tags":["bark","croute","rub","maillard","caramelisation","fumee"],"meat_type":null,"created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"1a55f4b8-e83d-472a-9786-e87d14e28521","title":"Les températures de cuisson au fumoir","slug":"guide-temperatures-cuisson","summary":"Température du fumoir, température cible, zone de danger : le tableau complet.","cover_url":"https://images.pexels.com/photos/1309065/pexels-photo-1309065.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"technique","tags":["temperature","fumoir","cuisson","low-and-slow","hot-and-fast","tableau"],"meat_type":null,"created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"19173e2f-0aac-4f32-8696-02f3bf24df08","title":"Les 10 erreurs de débutant au fumoir","slug":"guide-erreurs-debutant","summary":"Température instable, viande sèche, fumée blanche... Les pièges les plus courants quand on débute.","cover_url":"https://images.pexels.com/photos/2491272/pexels-photo-2491272.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"technique","tags":["erreurs","debutant","fumoir","conseils","temperature","stall"],"meat_type":null,"created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"5b7bcb8b-e7cb-4147-ba3f-f24e415f57a2","title":"Le sel en barbecue : salaison sèche et saumure","slug":"guide-sel-assaisonnement","summary":"Le sel est l'ingrédient le plus important du BBQ. Comment bien l'utiliser.","cover_url":"https://images.pexels.com/photos/2814828/pexels-photo-2814828.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"technique","tags":["sel","guerande","saumure","salaison-seche","dry-brine","assaisonnement"],"meat_type":null,"created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"0ff3e9f5-b900-4b1b-80ca-5d0ad1d69db7","title":"Les styles de sauce barbecue","slug":"guide-sauces-bbq","summary":"Kansas City, Carolina, Texas, Alabama... Chaque région a sa sauce.","cover_url":"https://images.pexels.com/photos/4033325/pexels-photo-4033325.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"technique","tags":["sauce-bbq","kansas-city","carolina","texas","alabama","memphis"],"meat_type":null,"created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"db205f0c-2ade-4f1d-969a-f4b6b2a2af86","title":"Quel fumoir choisir pour débuter ?","slug":"guide-choisir-fumoir","summary":"Weber, offset, granulés, kamado — chaque fumoir a ses avantages.","cover_url":"https://images.pexels.com/photos/2491272/pexels-photo-2491272.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"equipement","tags":["fumoir","weber","offset","granules","kamado","bouilloire","debutant"],"meat_type":null,"created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"05212b94-f15f-4b00-956c-2d5fc2341c0c","title":"Le thermomètre : l'outil indispensable","slug":"guide-thermometre","summary":"Sans thermomètre précis, tu cuisines à l'aveugle. Voici lesquels choisir.","cover_url":"https://images.pexels.com/photos/792027/pexels-photo-792027.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"equipement","tags":["thermometre","sonde","temperature","thermoworks","thermopro"],"meat_type":null,"created_at":"2026-03-31T21:22:46.80787+00:00"},{"id":"44473a67-0840-41fe-9f4e-dbcc97eb298a","title":"Le repos de la viande : pourquoi c'est non négociable","slug":"guide-repos-viande","summary":"Le repos transforme une bonne cuisson en cuisson exceptionnelle.","cover_url":"https://images.pexels.com/photos/9424951/pexels-photo-9424951.jpeg?auto=compress&cs=tinysrgb&w=800&h=400&fit=crop","category":"technique","tags":["repos","carryover","glaciere","jus","tendrete"],"meat_type":null,"created_at":"2026-03-31T21:22:46.80787+00:00"}]}]
