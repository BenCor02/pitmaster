7:["$","$L12",null,{"prefetchedRecipe":{"id":"e1572d2d-3cb7-44cc-9ac6-6ca39d5a6030","title":"Old Bay BBQ Rub","slug":"old-bay-bbq-rub","type":"rub","summary":"Le classique du Maryland enrichi pour le BBQ. Céleri, paprika, moutarde, clou de girofle.","description":"Old Bay est LE seasoning de la côte est US, normalement pour les fruits de mer. Cette version BBQ ajoute du sucre et du poivre pour le fumoir. Incroyable sur les ailes de poulet fumées.","ingredients":[{"qty":"20g","name":"Paprika"},{"qty":"15g","name":"Sel de céleri"},{"qty":"10g","name":"Moutarde sèche"},{"qty":"10g","name":"Poivre noir"},{"qty":"15g","name":"Cassonade"},{"qty":"5g","name":"Gingembre moulu"},{"qty":"3g","name":"Cannelle"},{"qty":"2g","name":"Clou de girofle moulu"},{"qty":"2g","name":"Piment de la Jamaïque"},{"qty":"2g","name":"Cardamome"},{"qty":"3g","name":"Cayenne"}],"steps":["Mélanger tous les ingrédients.","Appliquer sur poulet, fruits de mer ou porc."],"yield_amount":"90g","prep_time":"5 min","meat_types":["whole_chicken","spare_ribs"],"origin":"Maryland, USA","difficulty":"facile","tags":["old-bay","maryland","céleri","fruits-de-mer"],"cover_url":null,"status":"published","sort_order":38,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"old-bay-bbq-rub"}]
