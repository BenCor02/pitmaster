7:["$","$L12",null,{"prefetchedRecipe":{"id":"dd4fb249-15b3-45f2-9625-8687a5c73441","title":"Marinade Teriyaki Authentique","slug":"marinade-teriyaki-authentique","type":"marinade","summary":"Soja, mirin, sake, sucre. Le ratio japonais 2:2:2:1 pour un teriyaki parfait.","description":"Le vrai teriyaki n'est pas un sirop épais — c'est une sauce fine et brillante. Le mirin apporte la douceur, le sake la profondeur, la sauce soja l'umami. Ratio classique 2:2:2:1.","ingredients":[{"qty":"80ml","name":"Sauce soja japonaise"},{"qty":"80ml","name":"Mirin"},{"qty":"80ml","name":"Saké de cuisine"},{"qty":"40g","name":"Sucre"},{"qty":"10g","name":"Gingembre frais râpé","note":"Optionnel"},{"qty":"2 gousses","name":"Ail émincé","note":"Optionnel"}],"steps":["Combiner soja, mirin, saké et sucre dans une casserole.","Porter à ébullition en remuant.","Réduire et mijoter 10-15 min.","Laisser refroidir avant d'utiliser en marinade.","Mariner le poulet 2-4h.","Pour un glaze : badigeonner en fin de cuisson."],"yield_amount":"~300ml","prep_time":"20 min + 2-4h","meat_types":["whole_chicken","spare_ribs"],"origin":"Japon","difficulty":"facile","tags":["teriyaki","japonais","soja","mirin","umami"],"cover_url":null,"status":"published","sort_order":53,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"marinade-teriyaki-authentique"}]
