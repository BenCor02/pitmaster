7:["$","$L12",null,{"prefetchedRecipe":{"id":"d30bf771-7138-4431-a271-aa921897d755","title":"Injection au bouillon et jus de pomme (volaille)","slug":"injection-bouillon-pomme-volaille","type":"injection","summary":"Bouillon de volaille, jus de pomme, beurre et sauge. Le poulet fumé le plus juteux que tu feras.","description":"Le jus de pomme apporte une douceur subtile qui se marie parfaitement avec la volaille fumée. La sauge rappelle la cuisine française traditionnelle du poulet rôti.","ingredients":[{"qty":"200 ml","name":"Bouillon de volaille"},{"qty":"80 ml","name":"Jus de pomme (pur)"},{"qty":"30 g","name":"Beurre fondu"},{"qty":"3 g","name":"Sauge séchée"},{"qty":"3 g","name":"Sel"},{"qty":"2 g","name":"Poivre blanc"}],"steps":["Chauffer le bouillon et le jus de pomme ensemble.","Y fondre le beurre, ajouter la sauge, le sel et le poivre.","Filtrer finement.","Injecter dans les cuisses, les blancs et les pilons du poulet.","Laisser reposer 4h au frigo minimum."],"yield_amount":"300 ml — 1 poulet entier","prep_time":"10 min + 4h repos","meat_types":["whole_chicken","chicken_breasts"],"origin":"France — poulet rôti adapté fumoir","difficulty":"facile","tags":["injection","poulet","pomme","bouillon","volaille"],"cover_url":null,"status":"published","sort_order":102,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"injection-bouillon-pomme-volaille"}]
