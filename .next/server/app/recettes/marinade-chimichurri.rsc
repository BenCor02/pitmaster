7:["$","$L12",null,{"prefetchedRecipe":{"id":"cb1f36ab-27dd-4cbe-9484-60be35ab4195","title":"Marinade Chimichurri (Argentine)","slug":"marinade-chimichurri","type":"marinade","summary":"Persil, origan, ail, vinaigre de vin rouge, huile d'olive. La sauce nationale de l'asado argentin.","description":"Le chimichurri est utilisé en Argentine à la fois comme marinade et comme sauce de table pour l'asado. La version marinade est plus liquide. Utilise du persil plat frais — jamais du séché.","ingredients":[{"qty":"80 g","name":"Persil plat frais haché"},{"qty":"10 g","name":"Origan frais (ou 5g séché)"},{"qty":"6 gousses","name":"Ail finement haché"},{"qty":"60 ml","name":"Vinaigre de vin rouge"},{"qty":"120 ml","name":"Huile d'olive"},{"qty":"3 g","name":"Piment rouge broyé"},{"qty":"5 g","name":"Sel"}],"steps":["Hacher finement le persil et l'ail (au couteau, pas au mixeur).","Mélanger avec l'origan, le vinaigre, le sel et le piment.","Ajouter l'huile d'olive, mélanger.","Laisser reposer 30 min à température ambiante avant d'utiliser.","Comme marinade : 2 à 4h max (le vinaigre 'cuit' la viande si trop longtemps)."],"yield_amount":"300 ml","prep_time":"15 min","meat_types":["brisket","tomahawk","beef_short_ribs","prime_rib"],"origin":"Argentine — tradition asado","difficulty":"facile","tags":["chimichurri","argentin","asado","boeuf","persil"],"cover_url":null,"status":"published","sort_order":81,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"marinade-chimichurri"}]
