7:["$","$L12",null,{"prefetchedRecipe":{"id":"85ef7300-c886-4395-ba78-1e8f6177bcbc","title":"Sweet Heat Rib Rub","slug":"sweet-heat-rib-rub","type":"rub","summary":"Sucré-piquant : cassonade, chipotle, cannelle. Le rub de compétition pour des ribs gagnantes.","description":"Inspiré de Myron Mixon (5x champion du monde). Équilibre sucré/piquant. La cassonade caramélise, le chipotle apporte un piquant fumé, la cannelle une chaleur douce.","ingredients":[{"qty":"80g","name":"Cassonade foncée"},{"qty":"30g","name":"Paprika"},{"qty":"15g","name":"Poivre noir"},{"qty":"15g","name":"Poudre d'ail"},{"qty":"12g","name":"Chipotle en poudre"},{"qty":"10g","name":"Poudre d'oignon"},{"qty":"25g","name":"Sel kosher"},{"qty":"5g","name":"Cannelle"},{"qty":"5g","name":"Cayenne"},{"qty":"5g","name":"Moutarde sèche"}],"steps":["Mélanger, écraser les grumeaux.","Retirer la membrane des ribs.","Binder (moutarde jaune), puis rub des deux côtés.","30 min de repos avant cuisson."],"yield_amount":"200g — 3 racks","prep_time":"5 min","meat_types":["spare_ribs","baby_back_ribs"],"origin":"Inspiré de Myron Mixon","difficulty":"facile","tags":["ribs","sucré","piquant","compétition","mixon"],"cover_url":null,"status":"published","sort_order":11,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"sweet-heat-rib-rub"}]
