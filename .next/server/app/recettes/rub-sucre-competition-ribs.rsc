7:["$","$L12",null,{"prefetchedRecipe":{"id":"4063b1bc-640e-442e-aa3e-f566fd3da582","title":"Rub sucré compétition (ribs)","slug":"rub-sucre-competition-ribs","type":"rub","summary":"Cassonade, paprika, moutarde sèche, poudre d'oignon. Le rub sucré de compétition BBQ pour des ribs caramélisés.","description":"En compétition KCBS, les ribs sont jugés sur la tendreté, le goût et l'apparence. Ce rub sucré crée un glaçage caramélisé pendant la cuisson qui brille à la lumière. C'est ce qu'on appelle les « candy ribs ».","ingredients":[{"qty":"40 g","name":"Cassonade foncée"},{"qty":"20 g","name":"Paprika doux"},{"qty":"10 g","name":"Poudre d'ail"},{"qty":"10 g","name":"Poudre d'oignon"},{"qty":"8 g","name":"Moutarde sèche"},{"qty":"5 g","name":"Cumin"},{"qty":"15 g","name":"Sel"},{"qty":"8 g","name":"Poivre noir"},{"qty":"2 g","name":"Cayenne"},{"qty":"2 g","name":"Cannelle"}],"steps":["Mélanger toutes les épices en brisant les grumeaux de cassonade.","Appliquer une couche de moutarde jaune sur les ribs (le liant).","Saupoudrer le rub en couche épaisse.","Laisser « suer » 15 min avant de mettre au fumoir.","Les ribs doivent briller après cuisson — c'est le signe que c'est réussi."],"yield_amount":"120 g — 2 racks de ribs","prep_time":"5 min","meat_types":["spare_ribs","baby_back_ribs"],"origin":"Compétition KCBS — championship ribs","difficulty":"moyen","tags":["compétition","sucré","ribs","candy","caramel","KCBS"],"cover_url":null,"status":"published","sort_order":75,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"rub-sucre-competition-ribs"}]
