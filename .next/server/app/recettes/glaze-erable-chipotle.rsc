7:["$","$L12",null,{"prefetchedRecipe":{"id":"07c01d59-e3eb-4b62-a5d7-a3c459674df3","title":"Glaze érable-chipotle","slug":"glaze-erable-chipotle","type":"glaze","summary":"Sirop d'érable du Québec et chipotle en adobo. Fumé sur fumé, sucré-piquant.","description":"L'érable est un des rares sucres qui résiste bien à la chaleur du fumoir sans brûler trop vite. Le chipotle (jalapeño fumé) double l'effet fumé. Combo magistral sur le porc.","ingredients":[{"qty":"100 ml","name":"Sirop d'érable"},{"qty":"20 g","name":"Chipotle en adobo (mixé)"},{"qty":"15 ml","name":"Vinaigre de cidre"},{"qty":"10 g","name":"Moutarde de Dijon"},{"qty":"2 g","name":"Sel"}],"steps":["Mixer ou écraser les chipotles en adobo.","Mélanger avec l'érable, le vinaigre, la moutarde et le sel.","Badigeonner généreusement 30-45 min avant la fin.","Deux couches : la première fige, la deuxième brille."],"yield_amount":"150 ml","prep_time":"5 min","meat_types":["spare_ribs","baby_back_ribs","pulled_pork","whole_chicken"],"origin":"Québec — fusion BBQ","difficulty":"facile","tags":["érable","chipotle","glaze","fumé","porc"],"cover_url":null,"status":"published","sort_order":92,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"glaze-erable-chipotle"}]
