7:["$","$L12",null,{"prefetchedRecipe":{"id":"b7f13652-836d-4b2b-8077-e808acfdf449","title":"Togarashi BBQ Rub","slug":"togarashi-bbq-rub","type":"rub","summary":"Le shichimi togarashi japonais adapté au fumoir. Sésame, nori, Sichuan, agrumes.","description":"Le togarashi est un mélange japonais de 7 épices. Cette version BBQ ajoute du sel et de l'ail pour un rub complet. Incroyable sur du poulet ou des côtes de porc.","ingredients":[{"qty":"10g","name":"Flocons de piment rouge"},{"qty":"10g","name":"Graines de sésame grillées"},{"qty":"8g","name":"Zeste d'orange séché"},{"qty":"5g","name":"Nori en poudre","note":"Algue séchée mixée"},{"qty":"5g","name":"Poivre de Sichuan"},{"qty":"5g","name":"Graines de pavot"},{"qty":"5g","name":"Gingembre moulu"},{"qty":"15g","name":"Sel kosher"},{"qty":"10g","name":"Poudre d'ail"}],"steps":["Mélanger tous les ingrédients.","Appliquer légèrement — les saveurs sont concentrées.","Excellent sur poulet yakitori ou côtes de porc."],"yield_amount":"75g","prep_time":"5 min","meat_types":["whole_chicken","spare_ribs","baby_back_ribs"],"origin":"Japon — adapté BBQ","difficulty":"moyen","tags":["japonais","togarashi","sésame","nori","fusion"],"cover_url":null,"status":"published","sort_order":34,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"togarashi-bbq-rub"}]
