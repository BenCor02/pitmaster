7:["$","$L12",null,{"prefetchedRecipe":{"id":"858e5eed-872b-4ca1-bcc5-ff6f0ff58606","title":"Memphis Dust","slug":"memphis-dust","type":"rub","summary":"Le rub sucré légendaire de Meathead. Cassonade, paprika, gingembre. LE rub pour le porc.","description":"Créé par Meathead Goldwyn (AmazingRibs.com), probablement le rub maison le plus reproduit au monde. Base sucrée pour une bark caramélisée. Pas de sel — saler séparément (½ c.à.c sel/livre, 12h avant).","ingredients":[{"qty":"110g","name":"Cassonade foncée"},{"qty":"110g","name":"Sucre blanc"},{"qty":"60g","name":"Paprika"},{"qty":"30g","name":"Poudre d'ail"},{"qty":"15g","name":"Poivre noir"},{"qty":"15g","name":"Gingembre moulu"},{"qty":"15g","name":"Poudre d'oignon"},{"qty":"8g","name":"Romarin en poudre"}],"steps":["Mélanger, casser les grumeaux de cassonade.","Stocker dans un contenant hermétique (3 mois).","Humidifier la viande, saupoudrer sans trop charger.","Saler séparément la veille."],"yield_amount":"350g — 4-5 cuissons","prep_time":"5 min","meat_types":["pulled_pork","spare_ribs","baby_back_ribs","whole_chicken"],"origin":"Meathead Goldwyn — AmazingRibs.com","difficulty":"facile","tags":["memphis","sucré","porc","ribs","meathead"],"cover_url":null,"status":"published","sort_order":10,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"memphis-dust"}]
