7:["$","$L12",null,{"prefetchedRecipe":{"id":"d2e58b6b-cc86-48cd-a80f-4689f4f3abd2","title":"Marinade Souvlaki Grec","slug":"marinade-souvlaki-grec","type":"marinade","summary":"Huile d'olive, citron, origan, ail. La marinade grecque ancestrale pour brochettes.","description":"Le souvlaki est la street food grecque par excellence. Cette marinade simple transforme n'importe quel poulet ou porc en brochettes mémorables. Servir avec tzatziki.","ingredients":[{"qty":"80ml","name":"Huile d'olive"},{"qty":"60ml","name":"Jus de citron frais"},{"qty":"10g","name":"Origan grec séché"},{"qty":"4 gousses","name":"Ail émincé"},{"qty":"8g","name":"Sel"},{"qty":"5g","name":"Poivre noir"},{"qty":"3g","name":"Paprika"}],"steps":["Mélanger tous les ingrédients.","Couper la viande en cubes de 3cm.","Mariner au frigo 2-8h dans un sac zip.","Enfiler sur des brochettes.","Griller sur charbon vif 3-4 min par face.","Servir avec tzatziki, pita et oignon rouge."],"yield_amount":"~250ml","prep_time":"5 min + 2-8h","meat_types":["whole_chicken"],"origin":"Grèce","difficulty":"facile","tags":["grec","souvlaki","brochettes","citron","origan"],"cover_url":null,"status":"published","sort_order":51,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"marinade-souvlaki-grec"}]
