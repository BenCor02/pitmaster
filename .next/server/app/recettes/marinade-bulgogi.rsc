7:["$","$L12",null,{"prefetchedRecipe":{"id":"26230219-bf88-4ac1-895e-babb1360ad47","title":"Marinade Bulgogi","slug":"marinade-bulgogi","type":"marinade","summary":"Soja, poire asiatique, sésame, gochujang. BBQ coréen au fumoir.","description":"La poire asiatique attendrit la viande grâce à ses enzymes. Le gochujang apporte un piquant fermenté unique. Fusion BBQ coréen-américain.","ingredients":[{"qty":"80ml","name":"Sauce soja"},{"qty":"1 poire","name":"Poire asiatique râpée"},{"qty":"40g","name":"Cassonade"},{"qty":"30ml","name":"Huile de sésame"},{"qty":"20g","name":"Gochujang"},{"qty":"5 gousses","name":"Ail émincé"},{"qty":"15g","name":"Gingembre râpé"},{"qty":"½ oignon","name":"Oignon râpé"},{"qty":"5g","name":"Poivre noir"},{"qty":"10g","name":"Graines de sésame"}],"steps":["Mixer poire, ail, gingembre et oignon.","Ajouter soja, cassonade, sésame, gochujang.","Mariner 2-4h (tranches fines) ou 8-12h (pièce entière)."],"yield_amount":"~350ml","prep_time":"10 min + 2-12h","meat_types":["brisket","beef_short_ribs","chuck_roast"],"origin":"Corée — adapté BBQ US","difficulty":"moyen","tags":["coréen","bulgogi","soja","gochujang","fusion"],"cover_url":null,"status":"published","sort_order":55,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"marinade-bulgogi"}]
