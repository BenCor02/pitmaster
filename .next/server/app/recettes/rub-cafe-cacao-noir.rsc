7:["$","$L12",null,{"prefetchedRecipe":{"id":"cf4ede02-29e9-4f42-aa55-91d0f4f433ab","title":"Rub café-cacao noir (bœuf)","slug":"rub-cafe-cacao-noir","type":"rub","summary":"Café torréfié foncé, cacao amer, poivre de Sarawak. Bark noire intense pour le brisket.","description":"Version premium du rub au café. Le cacao amer apporte de la profondeur, le café de l'amertume qui contraste avec le gras du bœuf, et le poivre de Sarawak une chaleur complexe. La bark obtenue est d'un noir intense.","ingredients":[{"qty":"20 g","name":"Café torréfié foncé, moulu gros"},{"qty":"10 g","name":"Cacao amer en poudre"},{"qty":"15 g","name":"Poivre de Sarawak (ou Tellicherry)"},{"qty":"25 g","name":"Sel casher"},{"qty":"15 g","name":"Cassonade foncée"},{"qty":"8 g","name":"Poudre d'ail"},{"qty":"5 g","name":"Piment ancho"}],"steps":["Mélanger toutes les épices.","Appliquer généreusement 1h avant cuisson.","Idéal avec du bois de chêne ou de noyer.","Attention : ne pas cuire au-dessus de 150°C — le café et le sucre brûlent."],"yield_amount":"100 g — 1 brisket","prep_time":"5 min","meat_types":["brisket","beef_short_ribs","chuck_roast"],"origin":"Inspiration Tuffy Stone & craft BBQ","difficulty":"moyen","tags":["café","cacao","bark","boeuf","brisket","noir"],"cover_url":null,"status":"published","sort_order":73,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"rub-cafe-cacao-noir"}]
