7:["$","$L12",null,{"prefetchedRecipe":{"id":"c2b4f2cf-6879-4db2-8771-44e19fe17e4a","title":"Spray beurre-ail pour volaille","slug":"spray-beurre-ail-volaille","type":"mop","summary":"Beurre clarifié, ail, citron et thym. Le spray qui donne une peau dorée et croustillante au poulet fumé.","description":"Le gras du beurre clarifié aide à obtenir une peau croustillante sur la volaille. L'ail et le citron parfument en douceur. Le beurre clarifié (ghee) est indispensable — le beurre normal bouche le spray à cause des protéines de lait. Utilise un flacon spray résistant à la chaleur, le mélange doit rester tiède.","ingredients":[{"qty":"100 ml","name":"Beurre clarifié (ghee) fondu"},{"qty":"30 ml","name":"Jus de citron"},{"qty":"5 g","name":"Ail en poudre"},{"qty":"2 g","name":"Thym séché"},{"qty":"3 g","name":"Sel"},{"qty":"100 ml","name":"Eau chaude"}],"steps":["Faire fondre le ghee et le mélanger à l'eau chaude pour le rendre assez liquide.","Ajouter le jus de citron, l'ail en poudre, le thym et le sel.","Verser dans un flacon spray.","Garder le mélange tiède (à côté du fumoir) pour éviter que le beurre fige.","Sprayer le poulet toutes les 30 min à partir de la première heure.","Insister sur les cuisses et le bréchet — les zones qui sèchent le plus vite."],"yield_amount":"250 ml — 2 poulets","prep_time":"5 min","meat_types":["whole_chicken"],"origin":"Pitmaster volaille","difficulty":"facile","tags":["spray","beurre","ail","poulet","volaille","peau","croustillant"],"cover_url":null,"status":"published","sort_order":121,"created_at":"2026-03-31T21:39:47.84753+00:00","updated_at":"2026-03-31T21:39:47.84753+00:00"},"slug":"spray-beurre-ail-volaille"}]
