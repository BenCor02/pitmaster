7:["$","$L12",null,{"prefetchedRecipe":{"id":"3d5988a7-363f-4549-85df-9707eddf0ef3","title":"Marinade Jerk Jamaïcain","slug":"marinade-jerk-jamaicain","type":"marinade","summary":"Scotch bonnet, piment de la Jamaïque, thym frais. Explosive et parfumée.","description":"La vraie marinade jerk : équilibre entre le scotch bonnet, l'allspice, le thym et le citron vert. Traditionnellement fumée sur du bois de pimento.","ingredients":[{"qty":"6 tiges","name":"Oignons verts"},{"qty":"2","name":"Scotch bonnet"},{"qty":"60ml","name":"Sauce soja"},{"qty":"45ml","name":"Jus de citron vert"},{"qty":"15g","name":"Piment de la Jamaïque"},{"qty":"10 brins","name":"Thym frais"},{"qty":"6 gousses","name":"Ail"},{"qty":"20g","name":"Gingembre frais"},{"qty":"30g","name":"Cassonade"},{"qty":"3g","name":"Cannelle"},{"qty":"2g","name":"Muscade"},{"qty":"5g","name":"Poivre noir"},{"qty":"30ml","name":"Huile végétale"}],"steps":["Mixer tout au blender en pâte.","Entailler la viande pour pénétration.","Masser généreusement.","Mariner 6-24h au frigo.","Fumer au bois de cerisier ou pommier."],"yield_amount":"~300ml","prep_time":"15 min + 6-24h","meat_types":["whole_chicken"],"origin":"Jamaïque","difficulty":"moyen","tags":["jerk","jamaïque","scotch-bonnet","épicé"],"cover_url":null,"status":"published","sort_order":62,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"marinade-jerk-jamaicain"}]
