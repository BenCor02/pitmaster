7:["$","$L12",null,{"prefetchedRecipe":{"id":"2ee4b552-982d-4b2c-9644-b82cf487d629","title":"Marinade jerk jamaïcaine","slug":"marinade-jerk-jamaicaine","type":"marinade","summary":"Piment scotch bonnet, piment de la Jamaïque, thym, oignon vert. Le feu des Caraïbes au fumoir.","description":"Le jerk est une tradition jamaïcaine de fumage au bois de piment (pimenta). La marinade est à la fois sucrée, épicée et aromatique. Attention au scotch bonnet — c'est un des piments les plus forts (100 000–350 000 SHU).","ingredients":[{"qty":"6","name":"Oignons verts (partie verte)"},{"qty":"1","name":"Piment scotch bonnet (ou habanero)","note":"Épépiner pour moins de feu"},{"qty":"10 g","name":"Piment de la Jamaïque moulu"},{"qty":"8 branches","name":"Thym frais"},{"qty":"4 gousses","name":"Ail"},{"qty":"15 g","name":"Gingembre frais"},{"qty":"30 ml","name":"Sauce soja"},{"qty":"30 ml","name":"Jus de citron vert"},{"qty":"20 g","name":"Cassonade"},{"qty":"2 g","name":"Cannelle"},{"qty":"2 g","name":"Muscade"},{"qty":"30 ml","name":"Huile"}],"steps":["Mixer tous les ingrédients jusqu'à obtenir une pâte épaisse.","Faire des incisions profondes dans la viande.","Masser la pâte dans les incisions et sur toute la surface.","Mariner 12 à 24h au réfrigérateur.","Fumer au bois de cerisier ou pommier à 120°C."],"yield_amount":"300 g — 2 kg de poulet","prep_time":"20 min + 12h marinade","meat_types":["whole_chicken","chicken_breasts","spare_ribs","pulled_pork"],"origin":"Jamaïque","difficulty":"moyen","tags":["jerk","jamaïcain","piquant","caraïbes","poulet"],"cover_url":null,"status":"published","sort_order":84,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"marinade-jerk-jamaicaine"}]
