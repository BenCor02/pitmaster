7:["$","$L12",null,{"prefetchedRecipe":{"id":"099fb5a7-6842-4eda-b025-dca25248fe7f","title":"Marinade au vin rouge et romarin (côte de bœuf)","slug":"marinade-vin-rouge-romarin","type":"marinade","summary":"Vin rouge charpenté, romarin, ail, baies de genièvre. Pour une côte de bœuf fumée d'exception.","description":"Le vin rouge apporte des tanins qui attendrissent les fibres musculaires. Le romarin frais et les baies de genièvre rappellent la cuisine de terroir française. Idéal pour une côte de bœuf en reverse sear au fumoir.","ingredients":[{"qty":"250 ml","name":"Vin rouge corsé (Cahors, Madiran)"},{"qty":"4 branches","name":"Romarin frais"},{"qty":"4 gousses","name":"Ail écrasé"},{"qty":"6","name":"Baies de genièvre écrasées"},{"qty":"10","name":"Poivre noir en grains"},{"qty":"30 ml","name":"Huile d'olive"},{"qty":"2","name":"Échalote émincée"},{"qty":"10 g","name":"Sel"}],"steps":["Écraser les baies de genièvre et le poivre au mortier.","Mélanger le vin, l'huile, l'ail, l'échalote et les épices.","Placer la viande dans un sac ou un plat, verser la marinade.","Mariner 12 à 24h au réfrigérateur en retournant 1 fois.","Sortir 1h avant cuisson, éponger la surface."],"yield_amount":"350 ml — 1 côte de bœuf","prep_time":"15 min + 12h marinade","meat_types":["prime_rib","tomahawk","chuck_roast"],"origin":"France — terroir sud-ouest","difficulty":"moyen","tags":["vin-rouge","romarin","côte-de-boeuf","français","reverse-sear"],"cover_url":null,"status":"published","sort_order":83,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"marinade-vin-rouge-romarin"}]
