7:["$","$L12",null,{"prefetchedRecipe":{"id":"2a35e0a9-cedc-422c-9ba6-dc167212f33f","title":"Rub méditerranéen (poulet fumé)","slug":"rub-mediterraneen-poulet","type":"rub","summary":"Sumac, za'atar, cumin, coriandre. Le Moyen-Orient rencontre le fumoir américain.","description":"Le sumac apporte une acidité citronnée sans liquide (parfait pour la bark). Le za'atar est un mélange de thym, sésame et sumac. Le cumin et la coriandre rappellent le Maghreb. Un rub unique.","ingredients":[{"qty":"10 g","name":"Sumac"},{"qty":"10 g","name":"Za'atar"},{"qty":"5 g","name":"Cumin moulu"},{"qty":"5 g","name":"Coriandre moulue"},{"qty":"15 g","name":"Sel"},{"qty":"5 g","name":"Poivre noir"},{"qty":"8 g","name":"Ail granulé"},{"qty":"15 ml","name":"Huile d'olive","note":"En liant"}],"steps":["Mélanger les épices sèches.","Enduire la volaille d'huile d'olive.","Appliquer le rub en massant sous la peau.","Fumer au bois de vigne ou d'olivier si disponible."],"yield_amount":"75 g — 1 poulet entier","prep_time":"5 min","meat_types":["whole_chicken","chicken_breasts","lamb_shoulder"],"origin":"Méditerranée orientale","difficulty":"facile","tags":["méditerranéen","sumac","zaatar","poulet","moyen-orient"],"cover_url":null,"status":"published","sort_order":74,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"rub-mediterraneen-poulet"}]
