7:["$","$L12",null,{"prefetchedRecipe":{"id":"d0d9e96b-63fe-40a3-809d-c1851a391c85","title":"Mop vinaigre de cidre et moutarde","slug":"mop-vinaigre-cidre-moutarde","type":"mop","summary":"Vinaigre de cidre, moutarde, beurre et cayenne. Le mop classique du pulled pork Carolina.","description":"En Caroline du Nord, le mop au vinaigre est la base du BBQ. On badigeonne l'épaule toutes les heures pour garder la surface humide et développer l'écorce (bark). L'acidité du vinaigre attendrit aussi les fibres.","ingredients":[{"qty":"250 ml","name":"Vinaigre de cidre"},{"qty":"100 ml","name":"Eau"},{"qty":"30 g","name":"Moutarde jaune"},{"qty":"30 g","name":"Beurre fondu"},{"qty":"15 ml","name":"Sauce piquante"},{"qty":"5 g","name":"Sel"},{"qty":"3 g","name":"Poivre noir"},{"qty":"2 g","name":"Cayenne"},{"qty":"15 g","name":"Cassonade"}],"steps":["Mélanger tous les ingrédients dans une casserole.","Chauffer à feu doux jusqu'à dissolution du sucre et de la moutarde.","Ne pas faire bouillir.","Badigeonner avec un pinceau ou un mop (vadrouille miniature) toutes les 45 min à 1h.","Commencer après 2h de cuisson (laisser le rub se fixer d'abord)."],"yield_amount":"400 ml — 1 épaule","prep_time":"5 min","meat_types":["pulled_pork","spare_ribs"],"origin":"Caroline du Nord — tradition vinegar BBQ","difficulty":"facile","tags":["mop","vinaigre","cidre","carolina","porc","épaule"],"cover_url":null,"status":"published","sort_order":110,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"mop-vinaigre-cidre-moutarde"}]
