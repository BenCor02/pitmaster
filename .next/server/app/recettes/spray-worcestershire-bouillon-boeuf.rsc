7:["$","$L12",null,{"prefetchedRecipe":{"id":"8f17e0f9-edeb-44bf-838f-7ddeeb6eaa41","title":"Spray Worcestershire & bouillon de bœuf","slug":"spray-worcestershire-bouillon-boeuf","type":"mop","summary":"Bouillon concentré, Worcestershire, oignon. Le spray umami pour le brisket et les pièces de bœuf.","description":"Ce spray apporte de l'umami directement sur la surface du bœuf. La Worcestershire est riche en glutamate naturel (anchois fermenté), et le bouillon de bœuf renforce le goût viande. C'est le spray que beaucoup de pitmasters de compétition utilisent sur le brisket pour intensifier la saveur de la bark sans ajouter de sucre.","ingredients":[{"qty":"200 ml","name":"Bouillon de bœuf concentré"},{"qty":"60 ml","name":"Sauce Worcestershire"},{"qty":"100 ml","name":"Eau"},{"qty":"5 g","name":"Poudre d'oignon"},{"qty":"3 g","name":"Poivre noir moulu"}],"steps":["Chauffer légèrement le bouillon pour le fluidifier.","Ajouter la Worcestershire, l'eau, la poudre d'oignon et le poivre.","Bien mélanger et verser dans un flacon spray.","Sprayer le brisket toutes les 45 min à partir de la 3e heure.","Ce spray ne caramélise pas — tu peux l'utiliser même à haute température.","Idéal combiné avec un rub sel-poivre style Texas."],"yield_amount":"400 ml — 1 brisket","prep_time":"5 min","meat_types":["brisket","beef_short_ribs","chuck_roast","prime_rib"],"origin":"Compétition — style Texas","difficulty":"facile","tags":["spray","worcestershire","bouillon","boeuf","umami","compétition"],"cover_url":null,"status":"published","sort_order":122,"created_at":"2026-03-31T21:39:47.84753+00:00","updated_at":"2026-03-31T21:39:47.84753+00:00"},"slug":"spray-worcestershire-bouillon-boeuf"}]
