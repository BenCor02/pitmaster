7:["$","$L12",null,{"prefetchedRecipe":{"id":"b8211b34-5471-40fe-bdd5-a1c791f74337","title":"Cajun Fumé","slug":"rub-cajun-fume","type":"rub","summary":"Paprika fumé, cayenne, thym, origan. La chaleur louisianaise au fumoir.","description":"Le paprika fumé (pimentón de la Vera) renforce le goût de fumée. Le cayenne est dosé pour piquer sans brûler. Excellent sur le poulet entier ou les cuisses.","ingredients":[{"qty":"30g","name":"Paprika fumé"},{"qty":"25g","name":"Sel kosher"},{"qty":"20g","name":"Poudre d'ail"},{"qty":"15g","name":"Poivre noir"},{"qty":"15g","name":"Poudre d'oignon"},{"qty":"8g","name":"Cayenne"},{"qty":"8g","name":"Thym séché"},{"qty":"8g","name":"Origan séché"},{"qty":"5g","name":"Moutarde sèche"}],"steps":["Combiner tous les ingrédients.","Poulet : sous et sur la peau.","Porc : 2-4h avant cuisson."],"yield_amount":"150g","prep_time":"5 min","meat_types":["whole_chicken","pulled_pork","spare_ribs"],"origin":"Louisiane","difficulty":"facile","tags":["cajun","épicé","fumé","louisiane"],"cover_url":null,"status":"published","sort_order":25,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"rub-cajun-fume"}]
