7:["$","$L12",null,{"prefetchedRecipe":{"id":"e2e3977c-c1d1-4e19-b37b-45204916e616","title":"Chimichurri Authentique","slug":"chimichurri-authentique","type":"marinade","summary":"Persil, ail, origan, vinaigre de vin rouge, huile d'olive. Le classique argentin pur.","description":"Le vrai chimichurri argentin : pas de cilantro, pas de blender. Tout haché au couteau. Sert à la fois de marinade et de sauce de table pour l'asado (BBQ argentin).","ingredients":[{"qty":"1 gros bouquet (60g)","name":"Persil plat frais"},{"qty":"6 gousses","name":"Ail émincé"},{"qty":"10g","name":"Origan séché"},{"qty":"80ml","name":"Vinaigre de vin rouge"},{"qty":"120ml","name":"Huile d'olive extra vierge"},{"qty":"5g","name":"Flocons de piment rouge"},{"qty":"8g","name":"Sel"},{"qty":"3g","name":"Poivre noir"}],"steps":["Hacher finement le persil AU COUTEAU (pas au blender).","Émincer l'ail très fin.","Mélanger dans un bol avec l'origan, le piment et le sel.","Ajouter le vinaigre, mélanger.","Verser l'huile d'olive, mélanger.","Laisser reposer minimum 2h à température ambiante.","En marinade : badigeonner la viande 2h avant.","En sauce : servir à côté du steak grillé."],"yield_amount":"~300ml","prep_time":"10 min + 2h repos","meat_types":["tomahawk","brisket","beef_short_ribs"],"origin":"Argentine — asado traditionnel","difficulty":"facile","tags":["chimichurri","argentin","persil","asado","steak"],"cover_url":null,"status":"published","sort_order":50,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"chimichurri-authentique"}]
