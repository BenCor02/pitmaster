7:["$","$L12",null,{"prefetchedRecipe":{"id":"41498880-dc96-4cea-82eb-460e103c7c6f","title":"Marinade Satay (Cacahuète)","slug":"marinade-satay","type":"marinade","summary":"Lait de coco, cacahuète, citronnelle, curcuma. La marinade thaï/malaise pour des brochettes addictives.","description":"Le satay est répandu dans toute l'Asie du Sud-Est. La marinade elle-même contient peu de cacahuète — c'est la SAUCE de trempage qui en est riche. La citronnelle et le curcuma colorent et parfument.","ingredients":[{"qty":"100ml","name":"Lait de coco"},{"qty":"30ml","name":"Sauce soja"},{"qty":"20g","name":"Beurre de cacahuète"},{"qty":"20g","name":"Cassonade"},{"qty":"5g","name":"Curcuma"},{"qty":"2 tiges","name":"Citronnelle émincée"},{"qty":"3 gousses","name":"Ail"},{"qty":"5g","name":"Coriandre moulue"},{"qty":"3g","name":"Cumin"},{"qty":"5g","name":"Sel"}],"steps":["Mixer tous les ingrédients.","Couper la viande en fines lamelles.","Mariner 2-4h.","Enfiler en zigzag sur brochettes de bambou.","Griller sur charbon vif 2-3 min par côté.","Servir avec sauce cacahuète à part."],"yield_amount":"~250ml","prep_time":"10 min + 2-4h","meat_types":["whole_chicken","beef_short_ribs"],"origin":"Thaïlande / Malaisie","difficulty":"moyen","tags":["satay","thaï","cacahuète","citronnelle","brochettes"],"cover_url":null,"status":"published","sort_order":58,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"marinade-satay"}]
