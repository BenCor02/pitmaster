7:["$","$L12",null,{"prefetchedRecipe":{"id":"d3dd43b6-1881-459d-917e-096f5b189c8e","title":"Ras el Hanout BBQ","slug":"ras-el-hanout-bbq","type":"rub","summary":"Le mélange marocain royal adapté au BBQ. Cumin, cardamome, rose, muscade.","description":"Ras el Hanout signifie \"tête de la boutique\" — le meilleur mélange du marchand. Des dizaines d'épices possibles, mais cette version est optimisée pour le fumoir.","ingredients":[{"qty":"12g","name":"Cumin moulu"},{"qty":"10g","name":"Coriandre moulue"},{"qty":"12g","name":"Paprika"},{"qty":"8g","name":"Curcuma"},{"qty":"5g","name":"Cannelle"},{"qty":"5g","name":"Gingembre moulu"},{"qty":"3g","name":"Cardamome"},{"qty":"2g","name":"Clou de girofle"},{"qty":"2g","name":"Muscade"},{"qty":"3g","name":"Pétales de rose séchés","note":"Optionnel"},{"qty":"15g","name":"Sel kosher"},{"qty":"8g","name":"Poivre noir"}],"steps":["Mélanger toutes les épices.","Parfait sur agneau, poulet ou légumes grillés.","Appliquer avec huile d'olive comme binder."],"yield_amount":"85g","prep_time":"5 min","meat_types":["whole_chicken","pulled_pork"],"origin":"Maroc","difficulty":"moyen","tags":["marocain","ras-el-hanout","épices","agneau"],"cover_url":null,"status":"published","sort_order":32,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"ras-el-hanout-bbq"}]
