7:["$","$L12",null,{"prefetchedRecipe":{"id":"b5047286-8356-4526-8db2-68accf3c3097","title":"Five Pepper Rub","slug":"five-pepper-rub","type":"rub","summary":"Cinq poivres : noir, blanc, vert, rose, Sichuan. Pour les amateurs de poivre.","description":"Ce rub met le poivre à l'honneur sous toutes ses formes. Le Sichuan apporte un engourdissement unique, le rose une douceur florale, le vert de la fraîcheur. Spectaculaire sur un steak.","ingredients":[{"qty":"15g","name":"Poivre noir concassé"},{"qty":"10g","name":"Poivre blanc moulu"},{"qty":"5g","name":"Poivre vert lyophilisé"},{"qty":"5g","name":"Baies roses"},{"qty":"5g","name":"Poivre de Sichuan"},{"qty":"25g","name":"Sel kosher"},{"qty":"10g","name":"Poudre d'ail"}],"steps":["Concasser grossièrement les 5 poivres au mortier.","Mélanger avec sel et ail.","Appliquer sur steaks ou brisket."],"yield_amount":"75g","prep_time":"5 min","meat_types":["tomahawk","prime_rib","brisket","beef_short_ribs"],"origin":"Inspiration gastronomique","difficulty":"moyen","tags":["cinq-poivres","poivre","sichuan","gastronomique"],"cover_url":null,"status":"published","sort_order":31,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"five-pepper-rub"}]
