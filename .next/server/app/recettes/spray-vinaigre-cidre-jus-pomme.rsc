7:["$","$L12",null,{"prefetchedRecipe":{"id":"0d4f5868-4593-4d8f-a09b-25c06d3f25b2","title":"Spray vinaigre de cidre & jus de pomme","slug":"spray-vinaigre-cidre-jus-pomme","type":"mop","summary":"Le spritz classique des pitmasters. Vinaigre de cidre et jus de pomme 50/50 — simple, efficace, universel.","description":"C'est LE spray de référence en BBQ. Le vinaigre de cidre aide à fixer la fumée sur la surface de la viande et favorise la formation de la bark. Le jus de pomme apporte un sucre naturel qui caramélise doucement. Commence à sprayer après 2h de cuisson minimum — avant ça, tu empêches le rub de se fixer. Un coup de spray toutes les 45 min suffit. Chaque ouverture du fumoir coûte 15 min de récupération, donc sois rapide.","ingredients":[{"qty":"250 ml","name":"Vinaigre de cidre"},{"qty":"250 ml","name":"Jus de pomme (pur, sans sucre ajouté)"},{"qty":"50 ml","name":"Eau","note":"Optionnel, si trop acide"}],"steps":["Mélanger vinaigre de cidre et jus de pomme dans un flacon spray propre.","Secouer avant chaque utilisation.","Commencer à sprayer après minimum 2h de cuisson (la surface doit être sèche au toucher).","Sprayer à 20-30 cm de la viande, en brume légère — pas de jet direct.","Répéter toutes les 45 min à 1h.","Arrêter de sprayer quand tu wrappes (si tu wrappes)."],"yield_amount":"500 ml — plusieurs cuissons","prep_time":"2 min","meat_types":["brisket","pulled_pork","spare_ribs","baby_back_ribs","beef_short_ribs"],"origin":"Standard pitmaster US","difficulty":"facile","tags":["spray","spritz","vinaigre","cidre","pomme","classique","bark"],"cover_url":null,"status":"published","sort_order":120,"created_at":"2026-03-31T21:39:47.84753+00:00","updated_at":"2026-03-31T21:39:47.84753+00:00"},"slug":"spray-vinaigre-cidre-jus-pomme"}]
