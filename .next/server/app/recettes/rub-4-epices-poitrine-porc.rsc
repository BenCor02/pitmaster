7:["$","$L12",null,{"prefetchedRecipe":{"id":"06cfbcbf-bbbd-4df3-85cd-d3b0a509f1ec","title":"Rub 4 épices (poitrine de porc fumée)","slug":"rub-4-epices-poitrine-porc","type":"rub","summary":"Quatre-épices, cassonade, sel, poivre. Le mélange traditionnel français pour la poitrine fumée (bacon).","description":"Le quatre-épices (poivre, muscade, girofle, cannelle) est le mélange français classique pour les charcuteries. Combiné avec la cassonade et le sel, c'est la base d'un bacon maison fumé exceptionnel.","ingredients":[{"qty":"10 g","name":"Quatre-épices moulu"},{"qty":"40 g","name":"Cassonade"},{"qty":"30 g","name":"Sel fin"},{"qty":"8 g","name":"Poivre noir moulu"},{"qty":"5 g","name":"Ail en poudre"},{"qty":"3 g","name":"Thym séché"}],"steps":["Mélanger tous les ingrédients.","Frotter la poitrine de porc (lard frais) sur toutes les faces.","Placer dans un sachet hermétique, réfrigérer 3 jours en retournant chaque jour (salaison sèche).","Rincer, sécher, laisser à l'air 12h au frigo.","Fumer à froid (25°C) pendant 8 à 12h, ou à chaud (90°C) pendant 4h."],"yield_amount":"100 g — 2 kg de poitrine","prep_time":"10 min + 3 jours salaison","meat_types":["pulled_pork"],"origin":"France — charcuterie traditionnelle","difficulty":"avancé","tags":["quatre-épices","bacon","poitrine","charcuterie","français"],"cover_url":null,"status":"published","sort_order":71,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"rub-4-epices-poitrine-porc"}]
