7:["$","$L12",null,{"prefetchedRecipe":{"id":"8ec46d72-3f52-4820-baf4-77dd2a502ac1","title":"Rub herbes de Provence (agneau fumé)","slug":"rub-herbes-provence-agneau","type":"rub","summary":"Thym, romarin, sarriette, lavande, origan. Le rub français par excellence pour l'agneau au fumoir.","description":"Les herbes de Provence sont faites pour l'agneau. Au fumoir, elles créent une bark aromatique et parfumée. Ajoute du zeste de citron séché pour un kick méditerranéen.","ingredients":[{"qty":"20 g","name":"Herbes de Provence"},{"qty":"25 g","name":"Sel de mer"},{"qty":"10 g","name":"Poivre noir concassé"},{"qty":"10 g","name":"Ail granulé"},{"qty":"5 g","name":"Zeste de citron séché"},{"qty":"5 g","name":"Paprika doux"}],"steps":["Mélanger toutes les épices.","Frotter généreusement l'épaule ou le gigot d'agneau.","Laisser reposer 2h au frigo à découvert.","Fumer au bois de cerisier ou de vigne."],"yield_amount":"75 g — 1 épaule d'agneau","prep_time":"5 min","meat_types":["lamb_shoulder","lamb_ribs","lamb_legs"],"origin":"Provence, France","difficulty":"facile","tags":["provence","herbes","agneau","français","méditerranéen"],"cover_url":null,"status":"published","sort_order":70,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"rub-herbes-provence-agneau"}]
