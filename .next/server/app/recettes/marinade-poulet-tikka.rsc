7:["$","$L12",null,{"prefetchedRecipe":{"id":"4194e6af-8d1c-46ca-99ea-18f3a04f0785","title":"Marinade Brochettes Poulet Tikka","slug":"marinade-poulet-tikka","type":"marinade","summary":"Yaourt, garam masala, curcuma, citron. La marinade indienne onctueuse pour des brochettes tendres.","description":"Le tikka signifie \"morceau\" en hindi. Le yaourt sert de base pour attendrir ET pour que les épices adhèrent. Le garam masala donne la chaleur aromatique.","ingredients":[{"qty":"200g","name":"Yaourt nature épais"},{"qty":"10g","name":"Garam masala"},{"qty":"5g","name":"Curcuma"},{"qty":"10g","name":"Paprika"},{"qty":"8g","name":"Cumin moulu"},{"qty":"5g","name":"Coriandre moulue"},{"qty":"30ml","name":"Jus de citron"},{"qty":"4 gousses","name":"Ail émincé"},{"qty":"15g","name":"Gingembre râpé"},{"qty":"8g","name":"Sel"},{"qty":"3g","name":"Cayenne"},{"qty":"15ml","name":"Huile végétale"}],"steps":["Mélanger yaourt, épices, ail, gingembre et citron.","Couper le poulet en gros cubes.","Mariner 4-8h au frigo (pas plus, le yaourt sur-attendrit).","Enfiler sur brochettes métalliques.","Griller à haute température, servir avec sauce menthe."],"yield_amount":"~350ml — 1kg de poulet","prep_time":"10 min + 4-8h","meat_types":["whole_chicken"],"origin":"Inde — Pendjab","difficulty":"facile","tags":["tikka","indien","yaourt","brochettes","poulet"],"cover_url":null,"status":"published","sort_order":57,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"marinade-poulet-tikka"}]
