7:["$","$L12",null,{"prefetchedRecipe":{"id":"eac2d18e-2f66-4a10-b46f-ba29a0b463fc","title":"Marinade miso-érable","slug":"marinade-miso-erable","type":"marinade","summary":"Miso blanc, sirop d'érable, sake. Umami profond et caramel doré au fumoir.","description":"Le miso apporte un umami intense qui se marie parfaitement avec la fumée. Le sirop d'érable crée un glaçage naturel pendant la cuisson. Combo qui fonctionne sur tout : porc, poulet, saumon.","ingredients":[{"qty":"60 g","name":"Miso blanc (shiro)"},{"qty":"40 ml","name":"Sirop d'érable"},{"qty":"30 ml","name":"Sake ou vin blanc"},{"qty":"15 ml","name":"Sauce soja"},{"qty":"10 ml","name":"Huile de sésame"},{"qty":"10 g","name":"Gingembre râpé"},{"qty":"2 gousses","name":"Ail pressé"}],"steps":["Délayer le miso dans le sake à température ambiante.","Ajouter le sirop d'érable, la sauce soja, l'huile de sésame, le gingembre et l'ail.","Mélanger jusqu'à consistance homogène.","Enduire la viande, mariner 4 à 8h (pas plus, le miso est salé).","Éponger légèrement avant fumage."],"yield_amount":"200 ml — 1 kg de viande","prep_time":"10 min + 4h marinade","meat_types":["pulled_pork","spare_ribs","baby_back_ribs","whole_chicken"],"origin":"Fusion japon-québec","difficulty":"facile","tags":["miso","érable","umami","asiatique","porc"],"cover_url":null,"status":"published","sort_order":85,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"marinade-miso-erable"}]
