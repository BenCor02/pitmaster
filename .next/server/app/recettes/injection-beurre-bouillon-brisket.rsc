7:["$","$L12",null,{"prefetchedRecipe":{"id":"3ee9b1dc-aa55-46de-b63b-41a630f7721f","title":"Injection beurre-bouillon (brisket)","slug":"injection-beurre-bouillon-brisket","type":"injection","summary":"Beurre clarifié, bouillon de bœuf et Worcestershire. L'injection de compétition pour un brisket juteux.","description":"En compétition KCBS, la plupart des équipes injectent leur brisket 12h avant la cuisson. Le beurre apporte le gras interne, le bouillon la saveur, le Worcestershire l'umami. Le résultat : un flat (poitrine) qui ne sèche jamais.","ingredients":[{"qty":"60 g","name":"Beurre clarifié fondu"},{"qty":"200 ml","name":"Bouillon de bœuf concentré"},{"qty":"15 ml","name":"Sauce Worcestershire"},{"qty":"3 g","name":"Poudre d'ail"},{"qty":"3 g","name":"Poudre d'oignon"},{"qty":"3 g","name":"Sel"}],"steps":["Faire fondre le beurre, le mélanger au bouillon chaud.","Ajouter le Worcestershire, l'ail, l'oignon et le sel.","Filtrer avec un tamis fin (éviter les grumeaux dans l'aiguille).","Injecter dans le flat tous les 5 cm, en quadrillage.","Injecter le point (partie épaisse) tous les 3 cm.","Laisser reposer 12h au frigo avant cuisson."],"yield_amount":"300 ml — 1 brisket (5-7 kg)","prep_time":"15 min + 12h repos","meat_types":["brisket"],"origin":"Compétition KCBS — USA","difficulty":"moyen","tags":["injection","brisket","beurre","compétition","juteux"],"cover_url":null,"status":"published","sort_order":100,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"injection-beurre-bouillon-brisket"}]
