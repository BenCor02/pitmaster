7:["$","$L12",null,{"prefetchedRecipe":{"id":"f454c52e-4da9-4459-9868-8dacc223f7b5","title":"Rub au Raifort & Moutarde","slug":"rub-raifort-moutarde","type":"rub","summary":"Moutarde sèche, raifort en poudre et poivre. Piquant et vif pour le boeuf.","description":"Le raifort en poudre donne un piquant nasal unique qui se marie parfaitement avec le gras du boeuf. La moutarde sèche renforce cette chaleur. Parfait pour un prime rib ou un rosbif fumé.","ingredients":[{"qty":"20g","name":"Moutarde sèche"},{"qty":"15g","name":"Raifort en poudre"},{"qty":"20g","name":"Poivre noir"},{"qty":"25g","name":"Sel kosher"},{"qty":"10g","name":"Poudre d'ail"},{"qty":"5g","name":"Thym séché"},{"qty":"10g","name":"Poudre d'oignon"}],"steps":["Mélanger tous les ingrédients.","Appliquer en couche fine — c'est puissant.","Idéal pour le prime rib ou rosbif."],"yield_amount":"105g","prep_time":"3 min","meat_types":["prime_rib","brisket","tomahawk"],"origin":"Tradition britannique / BBQ US","difficulty":"facile","tags":["raifort","moutarde","boeuf","piquant"],"cover_url":null,"status":"published","sort_order":7,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"rub-raifort-moutarde"}]
