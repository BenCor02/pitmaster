7:["$","$L12",null,{"prefetchedRecipe":{"id":"63ac84a6-63c8-4e09-9299-d2b87567701b","title":"Brown Sugar Bourbon Rub","slug":"brown-sugar-bourbon-rub","type":"rub","summary":"Cassonade, poudre de bourbon et vanille. Riche et caramélisé pour les ribs.","description":"La poudre de bourbon (bourbon en poudre, trouvable en ligne) apporte les notes de vanille et de chêne sans l'humidité. Sinon, ajouter un trait de bourbon dans le binder.","ingredients":[{"qty":"80g","name":"Cassonade foncée"},{"qty":"20g","name":"Paprika fumé"},{"qty":"20g","name":"Sel kosher"},{"qty":"15g","name":"Poivre noir"},{"qty":"15g","name":"Poudre d'ail"},{"qty":"10g","name":"Poudre de bourbon","note":"Ou vanille en poudre"},{"qty":"10g","name":"Poudre d'oignon"},{"qty":"3g","name":"Cayenne"}],"steps":["Mélanger soigneusement.","Pour les ribs : binder au bourbon + moutarde.","Appliquer le rub, repos 30-45 min."],"yield_amount":"170g","prep_time":"5 min","meat_types":["spare_ribs","baby_back_ribs","pulled_pork"],"origin":"Sud des États-Unis","difficulty":"facile","tags":["bourbon","cassonade","vanille","ribs"],"cover_url":null,"status":"published","sort_order":16,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"brown-sugar-bourbon-rub"}]
