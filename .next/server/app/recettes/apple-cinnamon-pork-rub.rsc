7:["$","$L12",null,{"prefetchedRecipe":{"id":"b7621f27-0ee4-404c-b655-ecc2968ce3ed","title":"Apple Cinnamon Pork Rub","slug":"apple-cinnamon-pork-rub","type":"rub","summary":"Doux et automnal : pomme déshydratée, cannelle, muscade. Parfait pour le pulled pork.","description":"Un rub original qui joue sur l'accord classique porc-pomme. La poudre de pomme déshydratée apporte une douceur fruitée unique. La cannelle et la muscade complètent le profil automnal.","ingredients":[{"qty":"60g","name":"Cassonade"},{"qty":"25g","name":"Paprika fumé"},{"qty":"20g","name":"Poudre de pomme déshydratée","note":"Ou jus de pomme en poudre"},{"qty":"20g","name":"Sel kosher"},{"qty":"8g","name":"Cannelle"},{"qty":"10g","name":"Poudre d'ail"},{"qty":"3g","name":"Muscade"},{"qty":"3g","name":"Piment de la Jamaïque"},{"qty":"10g","name":"Poivre noir"}],"steps":["Mélanger toutes les épices.","Appliquer sur pork butt la veille.","Le bois de pommier se marie idéalement."],"yield_amount":"160g","prep_time":"5 min","meat_types":["pulled_pork","spare_ribs","baby_back_ribs"],"origin":"Pitmaster communauté r/smoking","difficulty":"facile","tags":["pomme","cannelle","automne","porc"],"cover_url":null,"status":"published","sort_order":12,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"apple-cinnamon-pork-rub"}]
