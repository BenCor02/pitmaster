7:["$","$L12",null,{"prefetchedRecipe":{"id":"a4aeb693-4520-46ea-b34e-82a060510f40","title":"Glaze miel-sriracha","slug":"glaze-miel-sriracha","type":"glaze","summary":"Miel, sriracha, vinaigre de riz et ail. Sucré, piquant, collant — la perfection sur des ailes fumées.","description":"Le combo miel-sriracha est devenu un classique de la street food. Sur des ailes de poulet ou des baby back ribs fumés, c'est explosif. Le vinaigre de riz équilibre le sucre.","ingredients":[{"qty":"80 g","name":"Miel"},{"qty":"40 ml","name":"Sriracha"},{"qty":"20 ml","name":"Vinaigre de riz"},{"qty":"3 g","name":"Ail en poudre"},{"qty":"10 ml","name":"Sauce soja"}],"steps":["Mélanger tous les ingrédients dans un bol.","Chauffer 2 min au micro-ondes ou dans une casserole.","Badigeonner la viande 20 min avant la fin de cuisson.","Remettre au fumoir pour caraméliser.","Servir avec un filet supplémentaire de glaze sur les pièces."],"yield_amount":"150 ml","prep_time":"5 min","meat_types":["baby_back_ribs","whole_chicken","chicken_breasts"],"origin":"Fusion street food","difficulty":"facile","tags":["miel","sriracha","glaze","piquant","poulet","ribs"],"cover_url":null,"status":"published","sort_order":91,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"glaze-miel-sriracha"}]
