7:["$","$L12",null,{"prefetchedRecipe":{"id":"e19e6d87-5ffb-430c-815e-7d86becbb8d9","title":"Marinade au yaourt et épices tandoori","slug":"marinade-yaourt-tandoori","type":"marinade","summary":"Yaourt grec, curcuma, cumin, paprika, garam masala. Le poulet tandoori version fumoir.","description":"Le yaourt attendrit la viande grâce à l'acide lactique, tout en créant une croûte épaisse et parfumée au fumoir. Technique empruntée au tandoor indien, adaptée au fumage low & slow.","ingredients":[{"qty":"200 g","name":"Yaourt grec nature"},{"qty":"5 g","name":"Curcuma"},{"qty":"5 g","name":"Cumin moulu"},{"qty":"10 g","name":"Paprika fumé"},{"qty":"5 g","name":"Garam masala"},{"qty":"5 g","name":"Ail en poudre"},{"qty":"3 g","name":"Gingembre moulu"},{"qty":"30 ml","name":"Jus de citron"},{"qty":"8 g","name":"Sel"},{"qty":"15 ml","name":"Huile"}],"steps":["Mélanger le yaourt avec toutes les épices et le citron.","Faire des incisions dans la viande (surtout le poulet entier).","Enduire généreusement, y compris sous la peau.","Mariner 6 à 12h au réfrigérateur.","Fumer à 135°C pendant 2 à 3h (poulet entier)."],"yield_amount":"300 g — 1 poulet entier","prep_time":"15 min + 6h marinade","meat_types":["whole_chicken","chicken_breasts","lamb_shoulder","lamb_legs"],"origin":"Inde — adapté fumoir","difficulty":"facile","tags":["tandoori","yaourt","poulet","agneau","indien","épices"],"cover_url":null,"status":"published","sort_order":82,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"marinade-yaourt-tandoori"}]
