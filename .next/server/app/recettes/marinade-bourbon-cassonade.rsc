7:["$","$L12",null,{"prefetchedRecipe":{"id":"d1965190-affc-4665-b708-423caa9c9791","title":"Marinade Bourbon & Cassonade","slug":"marinade-bourbon-cassonade","type":"marinade","summary":"Bourbon, cassonade, sauce soja, ail. Riche et complexe pour porc et boeuf.","description":"Le bourbon apporte vanille et caramel qui se marient avec la fumée. La sauce soja ajoute de l'umami.","ingredients":[{"qty":"120ml","name":"Bourbon"},{"qty":"80g","name":"Cassonade foncée"},{"qty":"60ml","name":"Sauce soja"},{"qty":"30ml","name":"Vinaigre de cidre"},{"qty":"15ml","name":"Huile de sésame"},{"qty":"4 gousses","name":"Ail émincé"},{"qty":"10g","name":"Gingembre râpé"},{"qty":"5g","name":"Poivre noir"},{"qty":"3g","name":"Flocons de piment"}],"steps":["Dissoudre la cassonade dans le bourbon tiédi.","Ajouter tous les ingrédients.","Mariner 4-12h en sac zip au frigo.","Sécher avant d'appliquer le rub."],"yield_amount":"~350ml","prep_time":"10 min + 4-12h","meat_types":["pulled_pork","chuck_roast","beef_short_ribs","spare_ribs"],"origin":"Sud des États-Unis","difficulty":"moyen","tags":["bourbon","cassonade","umami"],"cover_url":null,"status":"published","sort_order":60,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"marinade-bourbon-cassonade"}]
