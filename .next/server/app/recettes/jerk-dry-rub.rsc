7:["$","$L12",null,{"prefetchedRecipe":{"id":"f6aa32a9-ec96-4bf5-a37d-94f5a35bb6fc","title":"Jerk Dry Rub","slug":"jerk-dry-rub","type":"rub","summary":"Version sèche du jerk jamaïcain. Piment de la Jamaïque, scotch bonnet, thym, muscade.","description":"Pour ceux qui préfèrent un rub sec plutôt qu'une marinade humide. Le piment de la Jamaïque (allspice) est L'ingrédient clé du jerk. Le scotch bonnet en poudre apporte le feu.","ingredients":[{"qty":"20g","name":"Piment de la Jamaïque (allspice)"},{"qty":"15g","name":"Thym séché"},{"qty":"25g","name":"Cassonade"},{"qty":"15g","name":"Sel kosher"},{"qty":"10g","name":"Poivre noir"},{"qty":"10g","name":"Ail en poudre"},{"qty":"10g","name":"Oignon en poudre"},{"qty":"5g","name":"Scotch bonnet en poudre","note":"Ou habanero"},{"qty":"3g","name":"Cannelle"},{"qty":"3g","name":"Muscade"},{"qty":"5g","name":"Gingembre"}],"steps":["Mélanger toutes les épices.","Masser la viande généreusement.","Laisser reposer 2-4h au frigo.","Fumage au bois de cerisier ou pommier."],"yield_amount":"120g","prep_time":"5 min","meat_types":["whole_chicken","spare_ribs","pulled_pork"],"origin":"Jamaïque","difficulty":"moyen","tags":["jerk","jamaïque","épicé","allspice"],"cover_url":null,"status":"published","sort_order":15,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"jerk-dry-rub"}]
