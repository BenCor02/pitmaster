7:["$","$L12",null,{"prefetchedRecipe":{"id":"7077bc6d-57bf-4362-9e48-006a4d0445e8","title":"Injection créole (épaule de porc)","slug":"injection-creole-epaule-porc","type":"injection","summary":"Bouillon de porc, beurre de Louisiane, Cajun, ail. Injection épicée pour un pulled pork avec du caractère.","description":"Inspirée de la cuisine cajun de Louisiane, cette injection donne un pulled pork moelleux avec une profondeur de saveur qui surprend. Le beurre garde la viande grasse de l'intérieur.","ingredients":[{"qty":"250 ml","name":"Bouillon de porc (ou poulet)"},{"qty":"40 g","name":"Beurre fondu"},{"qty":"8 g","name":"Assaisonnement cajun"},{"qty":"10 ml","name":"Sauce piquante (Tabasco ou Crystal)"},{"qty":"5 g","name":"Ail en poudre"},{"qty":"15 g","name":"Miel"},{"qty":"3 g","name":"Sel"}],"steps":["Chauffer le bouillon, y fondre le beurre.","Ajouter tous les assaisonnements et le miel.","Bien mélanger et filtrer.","Injecter l'épaule tous les 4 cm en profondeur.","Emballer au film et réfrigérer 8 à 12h."],"yield_amount":"350 ml — 1 épaule de porc (3-4 kg)","prep_time":"10 min + 8h repos","meat_types":["pulled_pork"],"origin":"Louisiane — cajun","difficulty":"moyen","tags":["injection","créole","cajun","épaule","porc","louisiane"],"cover_url":null,"status":"published","sort_order":101,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"injection-creole-epaule-porc"}]
