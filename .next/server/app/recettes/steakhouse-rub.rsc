7:["$","$L12",null,{"prefetchedRecipe":{"id":"ddafade9-f70a-4823-bee1-439ed800c2ca","title":"Steakhouse Rub","slug":"steakhouse-rub","type":"rub","summary":"Le rub des grands steakhouses : ail, oignon, paprika fumé, herbes sèches. Classique et fiable.","description":"Ce rub reproduit les saveurs des meilleurs steakhouses américains. Le paprika fumé apporte la couleur, les herbes sèches la complexité. Fonctionne sur tout type de steak.","ingredients":[{"qty":"25g","name":"Sel kosher"},{"qty":"20g","name":"Poivre noir"},{"qty":"15g","name":"Paprika fumé"},{"qty":"15g","name":"Poudre d'ail"},{"qty":"10g","name":"Poudre d'oignon"},{"qty":"5g","name":"Origan séché"},{"qty":"5g","name":"Thym séché"},{"qty":"2g","name":"Cayenne"}],"steps":["Mélanger toutes les épices.","Assaisonner les steaks des deux côtés.","Repos 15-30 min à température ambiante."],"yield_amount":"100g","prep_time":"3 min","meat_types":["tomahawk","prime_rib","beef_short_ribs"],"origin":"Steakhouses américains","difficulty":"facile","tags":["steakhouse","steak","classique","herbes"],"cover_url":null,"status":"published","sort_order":8,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"steakhouse-rub"}]
