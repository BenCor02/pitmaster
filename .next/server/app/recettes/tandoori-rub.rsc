7:["$","$L12",null,{"prefetchedRecipe":{"id":"8c9c11d4-2f1f-409b-87a8-16918a74c14d","title":"Tandoori Rub","slug":"tandoori-rub","type":"rub","summary":"Cumin, coriandre, curcuma, garam masala, gingembre. Le rub indien pour un poulet fumé épicé.","description":"Inspiré de la cuisine tandoori, ce rub fonctionne aussi bien au fumoir qu'au four. Le garam masala apporte la complexité. Le curcuma la couleur. Mélanger avec du yaourt pour un binder parfait.","ingredients":[{"qty":"15g","name":"Cumin moulu"},{"qty":"15g","name":"Coriandre moulue"},{"qty":"10g","name":"Curcuma"},{"qty":"10g","name":"Garam masala"},{"qty":"15g","name":"Paprika"},{"qty":"8g","name":"Gingembre moulu"},{"qty":"10g","name":"Poudre d'ail"},{"qty":"15g","name":"Sel kosher"},{"qty":"5g","name":"Cayenne"},{"qty":"3g","name":"Cannelle"}],"steps":["Mélanger toutes les épices.","Binder : yaourt nature + jus de citron.","Mariner 4-12h au frigo.","Fumer à 150°C ou griller."],"yield_amount":"110g","prep_time":"5 min","meat_types":["whole_chicken"],"origin":"Inde — adapté BBQ","difficulty":"moyen","tags":["tandoori","indien","épicé","yaourt"],"cover_url":null,"status":"published","sort_order":22,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"tandoori-rub"}]
