7:["$","$L12",null,{"prefetchedRecipe":{"id":"412df2b4-0485-4453-ba00-1cc867d9dc61","title":"Marinade Al Pastor","slug":"marinade-al-pastor","type":"marinade","summary":"Achiote, chiles guajillo, ananas, vinaigre. La marinade mexicaine rouge et fumée.","description":"Le al pastor est né de la fusion libano-mexicaine. L'achiote donne la couleur rouge-orange iconique. Les chiles guajillo le piquant doux. L'ananas EN BOÎTE (pas frais, trop d'enzymes) apporte la douceur.","ingredients":[{"qty":"50g","name":"Pâte d'achiote"},{"qty":"4","name":"Chiles guajillo séchés","note":"Réhydratés 20 min dans l'eau chaude"},{"qty":"120ml","name":"Jus d'ananas EN BOÎTE"},{"qty":"40ml","name":"Vinaigre de cidre"},{"qty":"4 gousses","name":"Ail"},{"qty":"5g","name":"Cumin"},{"qty":"5g","name":"Origan mexicain"},{"qty":"1 piment + sauce","name":"Chipotle en adobo"},{"qty":"8g","name":"Sel"},{"qty":"3g","name":"Poivre noir"}],"steps":["Réhydrater les chiles 20 min dans l'eau chaude.","Mixer tout au blender jusqu'à consistance lisse.","Mariner le porc 12-24h au frigo.","Griller ou rôtir avec des tranches d'ananas.","Servir en tacos avec oignon, cilantro et salsa verde."],"yield_amount":"~400ml","prep_time":"30 min + 12-24h","meat_types":["pulled_pork","spare_ribs"],"origin":"Mexico — fusion libano-mexicaine","difficulty":"moyen","tags":["al-pastor","mexicain","achiote","ananas","tacos"],"cover_url":null,"status":"published","sort_order":54,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"marinade-al-pastor"}]
