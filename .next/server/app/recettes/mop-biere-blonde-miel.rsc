7:["$","$L12",null,{"prefetchedRecipe":{"id":"f5eeba41-c831-40a2-bc2b-e963370e14c1","title":"Mop bière blonde et miel","slug":"mop-biere-blonde-miel","type":"mop","summary":"Bière blonde, miel, ail et thym. Un mop léger et parfumé pour le poulet et le porc.","description":"La bière apporte des sucres qui caramélisent doucement sur la surface, et le houblon ajoute une amertume subtile. Utilise une bière blonde artisanale de préférence — les industrielles manquent de caractère.","ingredients":[{"qty":"330 ml","name":"Bière blonde"},{"qty":"30 g","name":"Miel"},{"qty":"20 g","name":"Beurre fondu"},{"qty":"2 gousses","name":"Ail pressé"},{"qty":"3 branches","name":"Thym frais"},{"qty":"3 g","name":"Sel"},{"qty":"2 g","name":"Poivre"}],"steps":["Mélanger la bière avec le miel fondu.","Ajouter le beurre, l'ail, le thym, le sel et le poivre.","Badigeonner toutes les 45 min à partir de la 2e heure de cuisson.","Conserver au chaud à côté du fumoir."],"yield_amount":"400 ml","prep_time":"5 min","meat_types":["whole_chicken","pulled_pork","spare_ribs","baby_back_ribs"],"origin":"BBQ craft beer","difficulty":"facile","tags":["mop","bière","miel","poulet","porc"],"cover_url":null,"status":"published","sort_order":111,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"mop-biere-blonde-miel"}]
