7:["$","$L12",null,{"prefetchedRecipe":{"id":"936d69af-23f3-4821-b28c-6a0ec86c1722","title":"Glaze balsamique et figues","slug":"glaze-balsamique-figues","type":"glaze","summary":"Réduction balsamique, confiture de figues et romarin. Finition française pour une pièce de bœuf fumée.","description":"Un glaze inspiré de la gastronomie française, parfait pour une côte de bœuf ou un tomahawk fumé en reverse sear. Le balsamique réduit en sirop, la figue ajoute une douceur fruitée et le romarin apporte la touche herbacée.","ingredients":[{"qty":"100 ml","name":"Vinaigre balsamique de Modène"},{"qty":"40 g","name":"Confiture de figues"},{"qty":"20 g","name":"Miel"},{"qty":"5 g","name":"Romarin frais haché"},{"qty":"2 g","name":"Poivre noir"},{"qty":"15 g","name":"Beurre"}],"steps":["Verser le balsamique dans une casserole à feu moyen.","Laisser réduire de moitié (environ 5 min).","Ajouter la confiture de figues et le miel, mélanger.","Hors du feu, incorporer le beurre et le romarin.","Badigeonner la pièce de bœuf après le repos, avant de servir."],"yield_amount":"150 ml","prep_time":"10 min","meat_types":["prime_rib","tomahawk","brisket"],"origin":"France — gastronomie adaptée BBQ","difficulty":"moyen","tags":["balsamique","figue","glaze","boeuf","français","romarin"],"cover_url":null,"status":"published","sort_order":93,"created_at":"2026-03-30T20:29:39.884836+00:00","updated_at":"2026-03-30T20:29:39.884836+00:00"},"slug":"glaze-balsamique-figues"}]
