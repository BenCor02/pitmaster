7:["$","$L12",null,{"prefetchedRecipe":{"id":"cba1b8d1-0de7-404b-8453-e31b6de80f29","title":"Marinade Mojo Cubain","slug":"marinade-mojo-cubain","type":"marinade","summary":"Jus d'orange amère, ail, cumin, origan. La base du porc rôti cubain.","description":"Le mojo criollo est LA marinade de Cuba. L'orange amère (naranja agria) est l'ingrédient clé. Si introuvable, mélanger jus d'orange et jus de citron vert 50/50.","ingredients":[{"qty":"150ml","name":"Jus d'orange amère","note":"Ou 75ml orange + 75ml citron vert"},{"qty":"60ml","name":"Huile d'olive"},{"qty":"8 gousses","name":"Ail émincé"},{"qty":"10g","name":"Cumin moulu"},{"qty":"8g","name":"Origan séché"},{"qty":"10g","name":"Sel"},{"qty":"5g","name":"Poivre noir"}],"steps":["Chauffer l'huile, ajouter l'ail — ne pas brunir.","Ajouter jus d'agrumes, cumin, origan, sel, poivre.","Laisser refroidir.","Injecter ET mariner le porc 12-24h.","Rôtir ou fumer lentement."],"yield_amount":"~300ml","prep_time":"10 min + 12-24h","meat_types":["pulled_pork","spare_ribs"],"origin":"Cuba","difficulty":"facile","tags":["cubain","mojo","orange","ail","porc"],"cover_url":null,"status":"published","sort_order":63,"created_at":"2026-03-30T11:31:03.414648+00:00","updated_at":"2026-03-30T11:31:03.414648+00:00"},"slug":"marinade-mojo-cubain"}]
