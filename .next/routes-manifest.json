{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/admin/[[...slug]]",
      "regex": "^/admin(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/admin(?:/(?<nxtPslug>.+?))?(?:/)?$"
    },
    {
      "page": "/guides/[slug]",
      "regex": "^/guides/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/guides/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/partage/[code]",
      "regex": "^/partage/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcode": "nxtPcode"
      },
      "namedRegex": "^/partage/(?<nxtPcode>[^/]+?)(?:/)?$"
    },
    {
      "page": "/recettes/[slug]",
      "regex": "^/recettes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/recettes/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/bbq",
      "regex": "^/bbq(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/bbq(?:/)?$"
    },
    {
      "page": "/bois",
      "regex": "^/bois(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/bois(?:/)?$"
    },
    {
      "page": "/calculateur",
      "regex": "^/calculateur(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/calculateur(?:/)?$"
    },
    {
      "page": "/carnet",
      "regex": "^/carnet(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/carnet(?:/)?$"
    },
    {
      "page": "/comparateur",
      "regex": "^/comparateur(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/comparateur(?:/)?$"
    },
    {
      "page": "/confidentialite",
      "regex": "^/confidentialite(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/confidentialite(?:/)?$"
    },
    {
      "page": "/guides",
      "regex": "^/guides(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/guides(?:/)?$"
    },
    {
      "page": "/journal",
      "regex": "^/journal(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/journal(?:/)?$"
    },
    {
      "page": "/live",
      "regex": "^/live(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/live(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/multi",
      "regex": "^/multi(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/multi(?:/)?$"
    },
    {
      "page": "/portions",
      "regex": "^/portions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/portions(?:/)?$"
    },
    {
      "page": "/recettes",
      "regex": "^/recettes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/recettes(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}